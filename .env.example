# 🔐 SECURITY: Environment Configuration Template
# Copy this file to .env and set secure values
# NEVER commit the .env file to version control!

# === CRITICAL SECURITY SETTINGS ===
# These MUST be set with strong, unique values

# JWT Secret Key (min 32 characters, use: openssl rand -base64 48)
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS_LONG

# Admin Password (min 12 characters, must include uppercase, lowercase, digits, special chars)
# Example: openssl rand -base64 20
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_SECURE_PASSWORD

# Grafana Admin Password (min 12 characters)
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_SECURE_PASSWORD


# === CORS CONFIGURATION ===
# Restrict to specific origins only (comma-separated, no spaces)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com


# === APPLICATION CONFIGURATION ===
LOG_LEVEL=INFO
WORKERS=4
REDIS_URL=redis://redis:6379/0
PROMETHEUS_ENABLED=true


# === OPTIONAL SECURITY SETTINGS ===
# Max samples per request (prevents DoS)
MAX_SAMPLES_PER_REQUEST=65536

# Rate limiting
DEFAULT_RATE_LIMIT=100/minute
ADMIN_RATE_LIMIT=1000/minute

# Session configuration
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password policy
MIN_PASSWORD_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15


# === SECURITY BEST PRACTICES ===
# 1. Generate JWT_SECRET_KEY using: python -c "import secrets; print(secrets.token_urlsafe(64))"
# 2. Use a password manager to generate and store ADMIN_PASSWORD
# 3. Rotate credentials regularly (every 90 days minimum)
# 4. Never use default passwords in production
# 5. Restrict ALLOWED_ORIGINS to your actual domains
# 6. Use HTTPS in production (configure nginx with SSL certificates)
# 7. Keep dependencies updated: pip install --upgrade -r requirements.txt
# 8. Review logs regularly for suspicious activity
# 9. Enable 2FA for admin accounts when available
# 10. Backup encryption keys securely
