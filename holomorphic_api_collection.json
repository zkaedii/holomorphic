                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"workflow_user\",\n  \"email\": \"workflow@example.com\",\n  \"password\": \"WorkflowPass123!\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/register",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "register"]
                }
              },
              "response": []
